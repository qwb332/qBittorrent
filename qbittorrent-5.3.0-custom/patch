+void TorrentsController::setMaxConnectionsAction()
+{
+    requireParams({u"hashes"_s, u"limit"_s});
+
+    const int limit = params()[u"limit"_s].toInt();
+    const QStringList hashes {params()[u"hashes"_s].split(u'|')};
+    applyToTorrents(hashes, [limit](BitTorrent::Torrent *const torrent) { torrent->setMaxConnections(limit); });
